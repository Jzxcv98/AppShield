<UserControl x:Class="AppShield.UI.ConversationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="7,12,10,5">
            <TextBlock Text="微信对话摘录" Style="{DynamicResource Section}"/>
            <TextBlock Style="{DynamicResource Caption}" TextWrapping="Wrap"
                       Text="点击提取后，切回微信并打开目标对话；无需固定窗口。核对本机预览后，可复制或另存全部或选中的文字。"/>
            <WrapPanel Margin="0,5,0,2">
                <Button x:Name="ExtractCurrentButton" Content="提取当前对话" Click="OnExtractCurrent" Style="{DynamicResource Primary}"
                        Margin="0,0,6,4" AutomationProperties.AutomationId="ExtractCurrentConversation"/>
                <Button x:Name="CancelExtractButton" Content="取消等待" Click="OnCancelExtract" Visibility="Collapsed"
                        Margin="0,0,6,4" AutomationProperties.AutomationId="CancelConversationExtraction"/>
                <CheckBox x:Name="IdentifyCurrentCheck" Content="切到微信时自动预览当前单聊（仅本机）" VerticalAlignment="Center"
                          Checked="OnIdentifyChanged" Unchecked="OnIdentifyChanged" AutomationProperties.AutomationId="IdentifyCurrentConversation"/>
            </WrapPanel>
            <TextBlock x:Name="IdentifyStatus" Style="{DynamicResource Caption}" TextWrapping="Wrap"/>
            <TextBlock x:Name="ExtractStatus" Style="{DynamicResource Caption}" TextWrapping="Wrap"/>
            <StackPanel x:Name="TranscriptArea" Visibility="Collapsed" Margin="0,5,0,6">
                <TextBlock x:Name="TranscriptLabel" FontWeight="SemiBold"/>
                <TextBox x:Name="TranscriptBox" IsReadOnly="True" IsUndoEnabled="False" MinHeight="70" MaxHeight="250"
                         Margin="0,3,0,5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" SelectionChanged="OnTranscriptSelection"
                         AutomationProperties.AutomationId="ConversationTranscript" AutomationProperties.Name="本机导出预览"/>
                <WrapPanel>
                    <Button x:Name="CopyTranscriptButton" Content="复制全文" Click="OnCopyTranscript" Margin="0,0,6,3"
                            AutomationProperties.AutomationId="CopyConversationTranscript"/>
                    <Button x:Name="SaveTranscriptButton" Content="另存文本…" Click="OnSaveTranscript" Margin="0,0,6,3"
                            AutomationProperties.AutomationId="SaveConversationTranscript"/>
                    <Button x:Name="ClearTranscriptButton" Content="清空预览" Click="OnClearTranscript" Margin="0,0,6,3"/>
                </WrapPanel>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource Line}" Margin="0,10,0,7"/>
            <Expander x:Name="LocalHistorySection" Header="本机历史记录与跟踪" Padding="0,3">
            <StackPanel Margin="3,5,0,4">
            <TextBlock Text="跟踪的对话" Style="{DynamicResource Section}"/>
            <WrapPanel>
                <ComboBox x:Name="TargetBox" MinWidth="156" Margin="0,0,6,5" Padding="5,3" SelectedIndex="0"
                          SelectionChanged="OnTargetEdited" AutomationProperties.Name="跟踪的对话">
                    <ComboBoxItem Content="File Transfer"/><ComboBoxItem Content="文件传输助手"/>
                    <ComboBoxItem Content="檔案傳輸助理"/><ComboBoxItem Content="本人或指定的一对一对话"/>
                </ComboBox>
                <StackPanel x:Name="SelfNamePanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Label Padding="0,3,4,0" Content="对话准确显示名" Target="{Binding ElementName=SelfNameBox}"/>
                    <TextBox x:Name="SelfNameBox" Width="155" Margin="0,0,6,5" MaxLength="96" Padding="4,3"
                             TextChanged="OnTargetEdited" AutomationProperties.Name="指定一对一对话的准确显示名"/>
                </StackPanel>
                <Button x:Name="OpenTargetButton" Content="打开本地记录" Click="OnOpenTarget" Margin="0,0,0,5"
                        AutomationProperties.AutomationId="ChatOpenTarget"/>
            </WrapPanel>
            <TextBlock x:Name="CaptureStatus" TextWrapping="Wrap" Style="{DynamicResource Caption}" Margin="0,4,0,4"
                       Text="选择文件传输助手或指定的一对一对话。"/>
            <WrapPanel>
                <Button x:Name="PreviewButton" Content="预览微信中的消息" Click="OnStartPreview" Margin="0,2,6,4"
                        AutomationProperties.AutomationId="ChatPreviewVisible"/>
                <Button x:Name="PauseButton" Content="暂停采集" Click="OnPause" Margin="0,2,0,4"
                        AutomationProperties.AutomationId="ChatPause"/>
            </WrapPanel>
            <StackPanel x:Name="CapturePreviewArea" Visibility="Collapsed" Margin="0,4,0,6">
                <TextBlock x:Name="CapturePreviewLabel" FontWeight="SemiBold"/>
                <TextBox x:Name="CapturePreviewBox" IsReadOnly="True" IsUndoEnabled="False" MinHeight="38" MaxHeight="110" Margin="0,3,0,4"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="待确认的消息"/>
                <WrapPanel>
                    <Button x:Name="ConfirmCaptureButton" Content="确认并开始记录" Click="OnConfirmCapture" Style="{DynamicResource Primary}" Margin="0,0,7,0"/>
                    <Button Content="放弃预览" Click="OnPause"/>
                </WrapPanel>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource Line}" Margin="0,9,0,10"/>
            <DockPanel>
                <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="清除记录…" Click="OnDelete"/>
                <TextBlock x:Name="HistoryLabel" Text="本机记录" Style="{DynamicResource Section}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox x:Name="HistoryBox" MinHeight="56" MaxHeight="140" Margin="0,5,0,4" IsReadOnly="True" IsUndoEnabled="False" SelectionChanged="OnTranscriptSelection"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="本机对话记录"/>
            <WrapPanel Margin="0,0,0,4">
                <Button x:Name="ExportHistoryButton" Content="预览全部本机记录" Click="OnExportHistory" Margin="0,0,6,3"/>
                <Button x:Name="ExportHistorySelectionButton" Content="仅预览历史选段" Click="OnExportHistorySelection" Margin="0,0,6,3"/>
            </WrapPanel>
            <Expander Header="手动添加选段" Margin="0,4,0,2">
                <StackPanel Margin="3,5,2,0">
                    <TextBlock Style="{DynamicResource Caption}" Text="仅粘贴所选对话的一条消息，再确认方向。"/>
                    <TextBox x:Name="ManualBox" MinHeight="45" MaxHeight="100" AcceptsReturn="True" TextWrapping="Wrap"
                             MaxLength="4000" TextChanged="OnFieldChanged" AutomationProperties.Name="手动输入的消息"/>
                    <WrapPanel Margin="0,4,0,2">
                        <ComboBox x:Name="DirectionBox" SelectedIndex="0" Padding="5,3" Margin="0,0,7,0" AutomationProperties.Name="消息方向">
                            <ComboBoxItem Content="方向未知"/><ComboBoxItem Content="我发的"/><ComboBoxItem Content="对方发的"/>
                        </ComboBox>
                        <Button x:Name="AddManualButton" Content="记入所选对话" Click="OnManualAppend"/>
                    </WrapPanel>
                </StackPanel>
            </Expander>
            </StackPanel>
            </Expander>
            <Border Height="1" Background="{DynamicResource Line}" Margin="0,10,0,10"/>
            <Expander x:Name="DraftSection" Header="GPT 回复建议（可选）" Collapsed="OnDraftSectionCollapsed">
            <StackPanel Margin="3,6,0,4">
            <CheckBox x:Name="AutoDraftCheck" Content="对方停顿后自动备稿" Margin="0,2,0,2"
                      Checked="OnAutoModeChanged" Unchecked="OnAutoModeChanged" AutomationProperties.AutomationId="ChatAutoDraft"/>
            <TextBlock x:Name="AutoDraftHint" Style="{DynamicResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4"
                       Text="确认并开始记录后可启用。勾选即允许 AppShield 在对方停顿约 10 秒后，将这一轮来信、最近的连续上下文和回复意图提交到 OpenAI。建议留在本页供你处理。"/>
            <TextBlock x:Name="AutoState" Style="{DynamicResource Caption}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4"/>
            <Label Content="你想怎么回（可选）" Target="{Binding ElementName=IntentBox}" Padding="0,1,0,3"/>
            <TextBox x:Name="IntentBox" MaxLength="500" Padding="5,4" TextChanged="OnIntentEdited" AutomationProperties.Name="回复意图"/>
            <WrapPanel Margin="0,5,0,4">
                <Button x:Name="PrepareButton" Content="预览发给 GPT 的内容" Click="OnPreparePrompt" Margin="0,0,7,3"
                        AutomationProperties.AutomationId="ChatPreparePrompt"/>
                <Expander Header="会话 API 密钥（可选）" VerticalAlignment="Center">
                    <StackPanel Margin="4,3,0,0">
                        <TextBlock Style="{DynamicResource Caption}" Text="留空使用本机配置的密钥。"/>
                        <PasswordBox x:Name="KeyBox" MinWidth="150" MaxLength="1024" AutomationProperties.Name="本次会话 API 密钥"/>
                    </StackPanel>
                </Expander>
            </WrapPanel>
            <StackPanel x:Name="RequestArea" Visibility="Collapsed">
                <TextBlock x:Name="RequestLabel" FontWeight="SemiBold"/>
                <TextBox x:Name="RequestBox" IsReadOnly="True" IsUndoEnabled="False" MinHeight="45" MaxHeight="145" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="本次发往 OpenAI 的完整对话材料"/>
                <Button x:Name="GenerateButton" Content="确认发送这些内容，生成草稿" Click="OnGenerate" HorizontalAlignment="Left"
                        Margin="0,5,0,3" Style="{DynamicResource Primary}" AutomationProperties.AutomationId="ChatSendApprovedPrompt"/>
            </StackPanel>
            <TextBlock x:Name="DraftStatus" Style="{DynamicResource Caption}" TextWrapping="Wrap" Margin="0,2,0,3"/>
            <TextBox x:Name="DraftBox" MinHeight="62" MaxHeight="140" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True" TextChanged="OnDraftEdited" AutomationProperties.Name="可编辑的回复草稿"/>
            <StackPanel x:Name="AlternativeArea" Visibility="Collapsed" Margin="0,4,0,0">
                <TextBlock Text="新建议" FontWeight="SemiBold"/>
                <TextBox x:Name="AlternativeBox" IsReadOnly="True" IsUndoEnabled="False" MaxHeight="110" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <Button x:Name="AdoptButton" Content="用新建议替换草稿" HorizontalAlignment="Left" Click="OnAdopt"/>
            </StackPanel>
            <Button x:Name="CopyButton" Content="复制草稿" Click="OnCopy" HorizontalAlignment="Left" Margin="0,5,0,0"/>
            </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
