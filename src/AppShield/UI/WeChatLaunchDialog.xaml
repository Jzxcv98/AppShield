<Window x:Class="AppShield.UI.WeChatLaunchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微信隔离启动" Width="530" SizeToContent="Height" ResizeMode="NoResize"
        Background="#F8FAFC" Foreground="#20344A" FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14" UseLayoutRounding="True" WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="WeChatLaunchDialog">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,5"/><Setter Property="MinHeight" Value="30"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Choices" Margin="0,0,5,0">
                <TextBlock FontSize="19" FontWeight="SemiBold" Text="选择微信的启动环境"/>
                <TextBlock x:Name="HostNotice" Margin="0,8,0,6" Foreground="#53667B"/>
                <RadioButton x:Name="AccountMode" Content="宿主桌面 · 专用 Windows 账户" GroupName="Mode"
                             Margin="0,10,0,4" IsChecked="True" Checked="OnModeChanged"
                             AutomationProperties.AutomationId="LaunchModeAccount"/>
                <TextBlock Margin="21,0,0,8" Foreground="#53667B"
                           Text="微信使用该标准账户的用户资料和“宿主文件保护”中的目录规则；与宿主共享桌面、剪贴板和网络。"/>
                <Grid x:Name="Credentials" Margin="21,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Label Content="本机标准账户" Target="{Binding ElementName=Account}" Padding="0,3"/>
                    <Label Grid.Column="2" Content="Windows 密码" Target="{Binding ElementName=Password}" Padding="0,3"/>
                    <TextBox x:Name="Account" Grid.Row="1" MaxLength="256" Padding="5,3"
                             TextChanged="OnAccountEdited" AutomationProperties.AutomationId="LaunchAccountName"/>
                    <PasswordBox x:Name="Password" Grid.Row="1" Grid.Column="2" MaxLength="256" Padding="5,3"
                                 PasswordChanged="OnAccountEdited" AutomationProperties.AutomationId="LaunchAccountPassword"/>
                </Grid>
                <RadioButton x:Name="SandboxMode" Content="一次性 Windows 沙盒" GroupName="Mode" Margin="0,12,0,4"
                             Checked="OnModeChanged" AutomationProperties.AutomationId="LaunchModeSandbox"/>
                <TextBlock Margin="21,0,0,8" Foreground="#53667B"
                           Text="可以和宿主微信同时运行。来宾仅只读共享安装材料，关闭剪贴板、摄像头与麦克风共享。关闭沙盒会清除来宾微信及数据。"/>
                <StackPanel x:Name="SandboxOptions" Margin="21,0,0,5" Visibility="Collapsed">
                    <CheckBox x:Name="AllowNetwork" Content="允许来宾联网以获取登录二维码（可能访问局域网）"
                              AutomationProperties.AutomationId="LaunchSandboxNetwork"/>
                    <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                        <Button Content="选择官方安装包…" Click="OnPick" AutomationProperties.AutomationId="ChooseSandboxInstaller"/>
                        <TextBlock x:Name="InstallerInfo" Width="205" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#53667B"/>
                    </WrapPanel>
                </StackPanel>
                <TextBlock Margin="0,13,0,0" Foreground="#53667B"
                           Text="AppContainer 权限仅供原生引擎使用。对话助手需要微信与 AppShield 在宿主同一账户运行；如需摘录，请照常打开该账户的微信。"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="Feedback" AutomationProperties.LiveSetting="Polite" Foreground="#71472C"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button x:Name="CancelButton" Content="取消" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="StartButton" Click="OnStart" IsDefault="True"
                        AutomationProperties.AutomationId="StartWeChatMode"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
